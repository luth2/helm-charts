{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECP Broker values",
  "type": "object", "additionalProperties": true, "required": ["instance"],
  "properties": {
    "enabled": {"type": "boolean"},
    "global": {"$ref": "#/definitions/global"},
    "instance": {
      "type": "array", "minItems": 0,
      "items": {
        "type": "object", "additionalProperties": true, "required": ["name"],
        "properties": {
          "name": {"$ref": "#/definitions/name"},
          "fullnameOverride": {"type": "string", "minLength": 1, "maxLength": 45, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "enabled": {"type": "boolean"}, "existingSecret": {"type": "string"},
          "secretRevision": {"type": "string"}, "checksumConfig": {"type": "boolean"},
          "image": {"$ref": "#/definitions/image"}, "replicaCount": {"type": "integer", "minimum": 0},
          "keepLogsAfterRestart": {"type": "boolean"},
          "storageData": {"$ref": "#/definitions/quantity"}, "storageLogs": {"$ref": "#/definitions/quantity"}, "storageLogsSize": {"$ref": "#/definitions/quantity"},
          "useSharedStorageForJournal": {"type": "boolean"}, "useSharedStorageForConfiguration": {"type": "boolean"},
          "sharedStorageClassJournal": {"type": "string"}, "sharedStorageClass": {"type": "string"},
          "sharedStorageSizeJournal": {"$ref": "#/definitions/quantity"}, "sharedStorageSize": {"$ref": "#/definitions/quantity"},
          "sharedStorageAccessMode": {"enum": ["ReadWriteOnce", "ReadWriteMany"]},
          "securityContext": {"$ref": "#/definitions/security"},
          "startupProbe": {"$ref": "#/definitions/restartProbe"}, "readinessProbe": {"$ref": "#/definitions/probe"}, "livenessProbe": {"$ref": "#/definitions/restartProbe"},
          "service": {"$ref": "#/definitions/service"}, "ingress": {"$ref": "#/definitions/ingress"}, "template": {"$ref": "#/definitions/template"},
          "brokerXml": {"type": "object", "additionalProperties": true, "properties": {
            "acceptor": {"$ref": "#/definitions/acceptor"},
            "highAvailability": {"type": "object", "additionalProperties": true, "properties": {"acceptor": {"$ref": "#/definitions/acceptor"}}}
          }},
          "env": {"type": "object", "additionalProperties": true}, "extraEnv": {"type": "array", "items": {"type": "object"}},
          "command": {"type": "array", "items": {"type": "string"}}, "args": {"type": "array", "items": {"type": "string"}},
          "initContainers": {"type": "array", "items": {"type": "object"}}, "containers": {"type": "array", "items": {"type": "object"}},
          "volumes": {"type": "array", "items": {"type": "object"}}, "volumeMounts": {"type": "array", "items": {"type": "object"}},
          "volumeClaimTemplates": {"type": "array", "items": {"$ref": "#/definitions/claim"}}
        },
        "allOf": [{
          "if": {"not": {"required": ["enabled"], "properties": {"enabled": {"const": false}}}},
          "then": {"required": ["existingSecret", "image"], "properties": {"existingSecret": {"$ref": "#/definitions/secretName"}}}
        }]
      }
    }
  },
  "definitions": {
    "name": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "secretName": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
    "quantity": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]+)?([EPTGMK]i?|m|k)?$"},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "image": {
      "type": "object", "additionalProperties": true, "required": ["name"], "not": {"required": ["registry"]},
      "anyOf": [{"required": ["tag"]}, {"required": ["digest"]}],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "^[^\\s@]+$"},
        "tag": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "global": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "storage": {"type": "object", "properties": {"class": {"type": "string"}}, "additionalProperties": true},
        "imageBusybox": {"type": "object", "properties": {"name": {"type": "string", "minLength": 1}, "tag": {"type": "string", "minLength": 1}}, "additionalProperties": true},
        "imagePullSecrets": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"$ref": "#/definitions/secretName"}}}}
      }
    },
    "security": {
      "type": "object", "additionalProperties": true,
      "properties": {"runAsUser": {"type": "integer", "minimum": 1}, "runAsGroup": {"type": "integer", "minimum": 1}, "fsGroup": {"type": "integer", "minimum": 1}, "fsGroupChangePolicy": {"enum": ["Always", "OnRootMismatch"]}}
    },
    "probe": {
      "description": "Readiness checks AMQP reachability; HA startup/liveness check PID 1 only so passive backups are not restarted.",
      "type": "object", "additionalProperties": true,
      "properties": {
        "enabled": {"type": "boolean"}, "initialDelaySeconds": {"type": "integer", "minimum": 0},
        "periodSeconds": {"type": "integer", "minimum": 1}, "timeoutSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1}, "successThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "restartProbe": {"allOf": [{"$ref": "#/definitions/probe"}, {"properties": {"successThreshold": {"const": 1}}}]},
    "port": {
      "type": "object", "additionalProperties": true, "required": ["port"],
      "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}, "nodePort": {"type": "integer", "minimum": 1, "maximum": 65535}}
    },
    "acceptor": {"type": "object", "additionalProperties": true, "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "service": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "http": {"$ref": "#/definitions/port"}, "https": {"$ref": "#/definitions/port"}, "amqp": {"$ref": "#/definitions/port"}, "amqps": {"$ref": "#/definitions/port"},
        "annotations": {"type": ["object", "null"], "additionalProperties": {"type": "string"}}, "loadBalancerIP": {"type": "string"}
      }
    },
    "ingress": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "enabled": {"type": "boolean"}, "apiVersion": {"const": "networking.k8s.io/v1"}, "ingressClassName": {"type": "string"},
        "host": {"type": "string", "minLength": 1, "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
        "contextPath": {"type": "string", "pattern": "^/"}, "annotations": {"$ref": "#/definitions/stringMap"},
        "tls": {"type": "object", "required": ["secretName"], "properties": {"secretName": {"$ref": "#/definitions/secretName"}}, "additionalProperties": true}
      },
      "allOf": [{"if": {"required": ["enabled"], "properties": {"enabled": {"const": true}}}, "then": {"required": ["host"]}}]
    },
    "template": {"type": "object", "additionalProperties": true, "properties": {"labels": {"$ref": "#/definitions/stringMap"}, "annotations": {"$ref": "#/definitions/stringMap"}}},
    "claim": {
      "type": "object", "additionalProperties": true, "required": ["metadata", "spec"],
      "properties": {
        "metadata": {"type": "object", "required": ["name"], "properties": {"name": {"$ref": "#/definitions/name"}}, "additionalProperties": true},
        "spec": {"type": "object", "required": ["accessModes", "resources"], "additionalProperties": true, "properties": {"accessModes": {"type": "array", "minItems": 1, "items": {"enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany", "ReadWriteOncePod"]}}, "storageClassName": {"type": "string"}, "resources": {"type": "object"}}}
      }
    }
  }
}